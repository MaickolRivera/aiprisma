# Dónde corre Laya: "browser" (por defecto, en el navegador del usuario) o "api" (backend de FastAPI)
VITE_ANALYSIS_MODE=browser

# Solo modo "browser": carpeta con encoder.onnx, head.onnx, tokenizer.json y rl_agent_config.json
# Usa un commit fijo (no "main"): el navegador guarda el modelo en caché y no se entera si cambia.
VITE_LAYA_MODEL_URL=https://huggingface.co/Steven10429/laya-multilingual-webgpu/resolve/f8b540df64967067beadc96f2de23a32485c891f/

# Solo modo "api"
VITE_API_URL_LOCAL=http://127.0.0.1:8000
